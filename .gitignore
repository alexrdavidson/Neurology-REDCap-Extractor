# --- PHI: never commit ---
data/
outputs/
*.accdb
*.mdb
*.laccdb
*.sqlite
*.sqlite3
*.db
*.enc
config/settings.yaml
# one settings file per condition (config/conditions.yaml); only the template is shared
config/settings.*.yaml
!config/settings.example.yaml
config/identifiers*.yaml
# Quality-review packets (`nmosd quality-packet`): scrubbed patient notes and reference answers
*quality review*/
packet_*/
Claude_reference/
Patient_*.md
Patient_*.json
*.key
linkage*
deid_report*.html
# Third-party logos: never in the public repo (the icon is drawn by scripts/make_icon.py)
assets/icon/brigham_mark.png
*brigham*.png

# Synthetic fixtures are regenerated by scripts/make_synthetic.py; only the generator is committed.
tests/fixtures/synthetic/*
!tests/fixtures/synthetic/README.md

# --- tooling ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.DS_Store
.streamlit/secrets.toml
# the app's own state (server port, setup downloads) and the Mac app, which scripts/make_mac_app.py makes per Mac
.app_state/
*.app/
.claude/settings.local.json
.claude/.cc-writes/
